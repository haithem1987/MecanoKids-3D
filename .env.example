# Supabase (optionnel — laissez vide pour fonctionnement 100 % offline)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Port du serveur Express (défaut : 3000)
PORT=3000

# Analytique anonyme (optionnel)
VITE_CF_ANALYTICS_TOKEN=   # token Cloudflare Web Analytics (sans cookie)
VITE_SENTRY_DSN=           # DSN Sentry pour les erreurs WebGL (lazy-loadé)
VITE_APP_VERSION=          # ex. 1.0.0 — utilisé dans les rapports Sentry
