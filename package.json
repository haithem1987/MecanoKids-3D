{
  "name": "mecanokids-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "start:local-prod": "tsx server.ts --prod",
    "preview": "npm run build && wrangler dev",
    "clean": "node -e \"import('node:fs').then(fs=>{fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true});})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
