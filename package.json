    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  }
